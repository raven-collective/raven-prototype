{
  "name": "@raven/desktop",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:sidecars": "powershell -ExecutionPolicy Bypass -File ./scripts/build-sidecars.ps1",
    "icons:taskbar": "node scripts/generate-thumbnail-icons.mjs",
    "build": "tsc && vite build",
    "test": "bun test",
    "preview": "vite preview",
    "tauri": "bun ./scripts/tauri.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web && vite build --config web/vite.config.ts",
    "web:android": "bun run web:build && tar -xzf node_modules/@capacitor/cli/assets/android-template.tar.gz -C web/android gradlew gradlew.bat gradle/wrapper/gradle-wrapper.jar gradle/wrapper/gradle-wrapper.properties settings.gradle gradle.properties && cap sync android && cd web/android && ./gradlew assemble"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emojibase-data": "18.0.0",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.21",
    "tailwind-merge": "^3.7.0",
    "thumbhash": "^0.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "livekit-client": "^2.23.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "twemoji-colr-font": "15.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "@capacitor/cli": "^8.6.0"
  }
}
