{
  "name": "@raven/desktop",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:sidecars": "powershell -ExecutionPolicy Bypass -File ./scripts/build-sidecars.ps1",
    "icons:taskbar": "node scripts/generate-thumbnail-icons.mjs",
    "build": "tsc && vite build",
    "test": "bun test",
    "preview": "vite preview",
    "tauri": "bun ./scripts/tauri.ts",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "tsc -p mobile && vite build --config mobile/vite.config.ts",
    "mobile:android": "bun run mobile:build && cap sync android && cd mobile/android && ./gradlew assemble"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tauri-apps/api": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emojibase-data": "18.0.0",
    "livekit-client": "^2.23.0",
    "lottie-web": "5.12.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.16",
    "tailwind-merge": "^3.3.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "twemoji-colr-font": "15.0.3",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
